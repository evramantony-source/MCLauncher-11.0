diff --git a/vulkan_loader.c b/vulkan_loader.c
--- a/vulkan_loader.c
+++ b/vulkan_loader.c
@@ -6,6 +6,7 @@
 #include <stdio.h>
 #include <dlfcn.h>
 #include <stdlib.h>
+#include <string.h>
 #include <jni.h>
 
 #include <driver_helper/nsbypass.h>
@@ -14,13 +15,32 @@
 
 static bool turnip_enabled = false;
 
+/*
+ * MCLauncher loads MojoExec from two Android linker namespaces: once while
+ * preparing the embedded JVM and again as SDL3's packaged dependency. Static
+ * state is not shared between those copies, so the SDL-side copy used to lose
+ * setUseTurnip(true) and silently fall back to the system Vulkan loader.
+ *
+ * Treat the process launch environment as the cross-namespace source of truth.
+ * The variable is only set to "turnip" when MCLauncher actually selected the
+ * bundled driver, so system-driver launches keep the upstream behaviour.
+ */
+static bool mclauncher_turnip_requested() {
+    const char* driver = getenv("MCLAUNCHER_GRAPHICS_DRIVER");
+    return driver != NULL && strcmp(driver, "turnip") == 0;
+}
+
 #ifdef ENABLE_TURNIP_LOADER
 bool load_turnip_vulkan() {
     static bool driver_loaded = false;
     if(driver_loaded) return true;
 
     const char* cache_dir = getenv("TMPDIR");
-    if(!linker_ns_load(mojoexec_native_dir)) return NULL;
+    const char* native_dir = mojoexec_native_dir;
+    if(native_dir == NULL || native_dir[0] == '\0') {
+        native_dir = getenv("LD_LIBRARY_PATH");
+    }
+    if(native_dir == NULL || native_dir[0] == '\0') {
+        printf("MojoExec: Turnip requested but no native library search path is available\n");
+        return false;
+    }
+    if(!linker_ns_load(native_dir)) return false;
     void* linkerhook = linker_ns_dlopen("liblinkerhook.so", RTLD_LOCAL | RTLD_NOW);
-    if(linkerhook == NULL) return NULL;
+    if(linkerhook == NULL) return false;
     void* turnip_driver_handle = linker_ns_dlopen("libvulkan_freedreno.so", RTLD_LOCAL | RTLD_NOW);
     if(turnip_driver_handle == NULL) {
         printf("MojoExec: Failed to load Turnip!\n%s\n", dlerror());
@@ -60,7 +80,8 @@ void* mojoexec_acq_vulkan_handle() {
     int flags = RTLD_LOCAL | RTLD_NOW;
 #ifdef ENABLE_TURNIP_LOADER
     if(android_get_device_api_level() >= 28) { // the loader does not support below that
-        if(turnip_enabled && load_turnip_vulkan())
+        const bool use_turnip = turnip_enabled || mclauncher_turnip_requested();
+        if(use_turnip && load_turnip_vulkan())
             // Reference the vulkan driver separately to avoid weirdness from libraries calling dlclose
             return linker_ns_dlopen("libmjlvlk.so", flags);
     }
@@ -78,8 +99,10 @@ Java_git_artdeell_mojoexec_MojoExec_setUseTurnip(JNIEnv *env, jclass clazz, jboolean enable) {
 // Does nothing if Turnip is unsupported - Mesa will load system driver automatically
 JNIEXPORT void JNICALL
 Java_git_artdeell_mojoexec_MojoExec_preloadVulkan(JNIEnv *env, jclass clazz) {
 #ifdef ENABLE_TURNIP_LOADER
-    if(!turnip_enabled) return;
+    if(!turnip_enabled && !mclauncher_turnip_requested()) return;
+    turnip_enabled = true;
     if(!load_turnip_vulkan()) {
         printf("MojoExec: Failed to preload Turnip!\n");
     }
 #endif
 }
