diff --git a/src/video/SDL_egl.c b/src/video/SDL_egl.c
--- a/src/video/SDL_egl.c
+++ b/src/video/SDL_egl.c
@@ -289,6 +289,34 @@ SDL_FunctionPointer SDL_EGL_GetProcAddressInternal(SDL_VideoDevice *_this, const
         const Uint32 eglver = (((Uint32)_this->egl_data->egl_version_major) << 16) | ((Uint32)_this->egl_data->egl_version_minor);
         const bool is_egl_15_or_later = eglver >= ((((Uint32)1) << 16) | 5);
 
+#if defined(SDL_VIDEO_DRIVER_ANDROID)
+        /*
+         * LWJGL's Linux OpenGL provider asks glXGetProcAddress from the
+         * library passed to SDL_GL_LoadLibrary(), then falls back to a direct
+         * symbol from that same library. Minecraft 26.3 Snapshot 6 requires
+         * SDL and LWJGL to return the identical pointer for glGetError.
+         *
+         * Mirror LWJGL's lookup order here. Calling EGL's resolver first can
+         * return an equivalent OpenLTW entry point at a different address.
+         */
+        if (_this->egl_data->egl_dll_handle) {
+            typedef SDL_FunctionPointer (*MCLauncher_GLGetProcAddress)(const char *);
+            MCLauncher_GLGetProcAddress get_proc =
+                (MCLauncher_GLGetProcAddress)SDL_LoadFunction(_this->egl_data->egl_dll_handle, "glXGetProcAddress");
+            if (get_proc) {
+                result = get_proc(proc);
+            } else {
+                SDL_ClearError();
+            }
+            if (!result) {
+                result = SDL_LoadFunction(_this->egl_data->egl_dll_handle, proc);
+                if (!result) {
+                    SDL_ClearError();
+                }
+            }
+        }
+#endif
+
         // EGL 1.5 can use eglGetProcAddress() for any symbol. 1.4 and earlier can't use it for core entry points.
         if (!result && is_egl_15_or_later && _this->egl_data->eglGetProcAddress) {
             result = _this->egl_data->eglGetProcAddress(proc);
@@ -829,9 +857,28 @@ static bool SDL_EGL_PrivateChooseConfig(SDL_VideoDevice *_this, bool set_config
         attribs[i++] = _this->gl_config.multisamplesamples;
     }
 
-    if (_this->gl_config.floatbuffers) {
-        attribs[i++] = EGL_COLOR_COMPONENT_TYPE_EXT;
-        attribs[i++] = EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT;
+    if (_this->gl_config.floatbuffers) {
+#if defined(SDL_VIDEO_DRIVER_ANDROID)
+        /*
+         * Snapshot 6 requests SDL_GL_FLOATBUFFERS. OpenLTW is configured by
+         * MojoExec as a desktop-GL compatibility renderer over a GLES/EGL
+         * Android window. A floating-point *window surface* is not required
+         * for the game's floating-point textures/FBOs, and forwarding the
+         * EXT-only EGL_COLOR_COMPONENT_TYPE_EXT key to that GLES path produces
+         * EGL_BAD_ATTRIBUTE on affected Android drivers.
+         *
+         * Keep the normal SDL behavior for a real non-forced EGL OpenGL path,
+         * but leave MojoExec's forced-GLES presentation surface at a supported
+         * fixed-point format. Also verify the extension before using its key.
+         */
+        if (!mojoexec_renderspec.force_gles_context &&
+            SDL_EGL_HasExtension(_this, SDL_EGL_DISPLAY_EXTENSION, "EGL_EXT_pixel_format_float")) {
+#endif
+            attribs[i++] = EGL_COLOR_COMPONENT_TYPE_EXT;
+            attribs[i++] = EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT;
+#if defined(SDL_VIDEO_DRIVER_ANDROID)
+        }
+#endif
     }
 
     if (_this->egl_data->is_offscreen) {
@@ -878,10 +925,74 @@ static bool SDL_EGL_PrivateChooseConfig(SDL_VideoDevice *_this, bool set_config
 
     SDL_assert(i < SDL_arraysize(attribs));
 
-    if (_this->egl_data->eglChooseConfig(_this->egl_data->egl_display,
-                                         attribs,
-                                         configs, SDL_arraysize(configs),
-                                         &found_configs) == EGL_FALSE ||
-        found_configs == 0) {
+    EGLBoolean choose_result = _this->egl_data->eglChooseConfig(
+        _this->egl_data->egl_display,
+        attribs,
+        configs, SDL_arraysize(configs),
+        &found_configs);
+
+#if defined(SDL_VIDEO_DRIVER_ANDROID)
+    /*
+     * Minecraft 26.3 Snapshot 6 asks SDL3 for a desktop-style OpenGL
+     * framebuffer before OpenLTW translates it to GLES. Some Android EGL
+     * implementations reject one of those optional config attributes with
+     * EGL_BAD_ATTRIBUTE instead of simply returning zero matching configs.
+     *
+     * Only retry after the normal request failed and MojoExec is forcing GLES.
+     * Existing versions whose normal EGL request succeeds never enter this
+     * path. The fallback keeps the required color/depth/stencil/window shape
+     * but drops optional desktop/extension config attributes and asks for the
+     * broadly-supported ES2 renderable bit; the actual context is still
+     * created at MojoExec's requested GLES 3 version.
+     */
+    if ((choose_result == EGL_FALSE || found_configs == 0) &&
+        mojoexec_renderspec.force_gles_context) {
+        EGLint compatibility_attribs[32];
+        int compatibility_i = 0;
+
+        compatibility_attribs[compatibility_i++] = EGL_RED_SIZE;
+        compatibility_attribs[compatibility_i++] = _this->gl_config.red_size;
+        compatibility_attribs[compatibility_i++] = EGL_GREEN_SIZE;
+        compatibility_attribs[compatibility_i++] = _this->gl_config.green_size;
+        compatibility_attribs[compatibility_i++] = EGL_BLUE_SIZE;
+        compatibility_attribs[compatibility_i++] = _this->gl_config.blue_size;
+        if (_this->gl_config.alpha_size) {
+            compatibility_attribs[compatibility_i++] = EGL_ALPHA_SIZE;
+            compatibility_attribs[compatibility_i++] = _this->gl_config.alpha_size;
+        }
+        if (_this->gl_config.depth_size) {
+            compatibility_attribs[compatibility_i++] = EGL_DEPTH_SIZE;
+            compatibility_attribs[compatibility_i++] = _this->gl_config.depth_size;
+        }
+        if (_this->gl_config.stencil_size) {
+            compatibility_attribs[compatibility_i++] = EGL_STENCIL_SIZE;
+            compatibility_attribs[compatibility_i++] = _this->gl_config.stencil_size;
+        }
+        compatibility_attribs[compatibility_i++] = EGL_RENDERABLE_TYPE;
+        compatibility_attribs[compatibility_i++] = EGL_OPENGL_ES2_BIT;
+        if (_this->egl_data->egl_surfacetype) {
+            compatibility_attribs[compatibility_i++] = EGL_SURFACE_TYPE;
+            compatibility_attribs[compatibility_i++] = _this->egl_data->egl_surfacetype;
+        }
+        compatibility_attribs[compatibility_i++] = EGL_NONE;
+
+        found_configs = 0;
+        choose_result = _this->egl_data->eglChooseConfig(
+            _this->egl_data->egl_display,
+            compatibility_attribs,
+            configs, SDL_arraysize(configs),
+            &found_configs);
+        if (choose_result != EGL_FALSE && found_configs > 0) {
+            SDL_memcpy(
+                attribs,
+                compatibility_attribs,
+                compatibility_i * sizeof(EGLint));
+            i = compatibility_i;
+            SDL_Log("MCLauncher: recovered Android GLES EGL config with conservative attributes");
+        }
+    }
+#endif
+
+    if (choose_result == EGL_FALSE || found_configs == 0) {
         return false;
     }
 
