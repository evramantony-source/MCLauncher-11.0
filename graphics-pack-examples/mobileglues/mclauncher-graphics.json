{
  "schemaVersion": 1,
  "architecture": "arm64-v8a",
  "id": "mobileglues",
  "name": "MobileGlues",
  "version": "replace-me",
  "kind": "renderer",
  "renderer": "MOBILE_GLUES",
  "pojavRenderer": "mobileglues",
  "preload": [
    "libmobileglues.so"
  ],
  "environment": {
    "LIBGL_ES": "3",
    "MG_DIR_PATH": "${cache}/mobileglues"
  },
  "sourceProject": "https://github.com/MobileGL-Dev/MobileGlues",
  "license": "LGPL-2.1"
}
